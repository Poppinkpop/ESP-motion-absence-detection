// secrets.h.example — kopieer dit naar secrets.h en vul je eigen
// gegevens in. secrets.h wordt NOOIT gecommit (zie .gitignore).
//
// Dit bestand gebruikt exact dezelfde macronamen als de code
// verwacht — kopieer dit bestand dus letterlijk naar secrets.h en vul
// alleen de waarden tussen de aanhalingstekens in, verander de
// macronamen zelf niet.
#pragma once

#define WiFi_SSID "jouw_wifi_naam"
#define WiFi_password "jouw_wifi_wachtwoord"

// Bot-token van BotFather (zie stappenplan) en het chat_id van de
// ontvanger (privéchat of groep — beide werken, chat_id is gewoon een
// getal; bij een groep is dat getal negatief).
#define TELEGRAM_BOT_TOKEN "jouw_bot_token"
#define TELEGRAM_CHAT_ID "jouw_chat_id"

#define PERSOONSGEGEVENS "naam of aanduiding van de persoon"